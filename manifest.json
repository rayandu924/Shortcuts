{
  "name": "Desktop Shortcuts",
  "version": "2.0.1",
  "description": "Desktop-style shortcut icons — add, arrange, and launch apps, files, and URLs",
  "author": "MyWallpaper",
  "entry": "index.js",
  "settings": {
    "iconsData": {
      "type": "string",
      "content": {
        "label": "Icons Data",
        "default": "[]",
        "hidden": true
      }
    },
    "actionsSection": {
      "type": "section",
      "content": {
        "label": "Actions"
      }
    },
    "addShortcut": {
      "type": "button",
      "content": {
        "label": "Add Shortcut",
        "buttonLabel": "Add Shortcut"
      }
    },
    "scanDesktop": {
      "type": "button",
      "content": {
        "label": "Import Desktop Icons",
        "buttonLabel": "Scan Desktop"
      }
    },
    "clearAll": {
      "type": "button",
      "content": {
        "label": "Remove All Icons",
        "buttonLabel": "Clear All"
      }
    },
    "appearanceSection": {
      "type": "section",
      "content": {
        "label": "Appearance"
      }
    },
    "iconSize": {
      "type": "range",
      "content": {
        "label": "Icon Size",
        "min": 32,
        "max": 96,
        "step": 4,
        "default": 48
      }
    },
    "gridSpacing": {
      "type": "range",
      "content": {
        "label": "Grid Spacing",
        "min": 60,
        "max": 160,
        "step": 5,
        "default": 90
      }
    },
    "showLabels": {
      "type": "boolean",
      "content": {
        "label": "Show Labels",
        "default": true
      }
    },
    "labelColor": {
      "type": "color",
      "content": {
        "label": "Label Color",
        "default": "#ffffff"
      }
    }
  },
  "permissions": {
    "fileAccess": {
      "reason": "Display shortcut icon images"
    },
    "openPath": true
  },
  "defaultLayout": {
    "xPercent": 0,
    "yPercent": 0,
    "widthPercent": 100,
    "heightPercent": 100
  },
  "ui": {
    "pointerEvents": "auto"
  }
}
